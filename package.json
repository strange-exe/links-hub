{
  "name": "abhinesh-links",
  "version": "1.0.0",
  "private": true,
  "description": "Link hub for Abhinesh Gangwar at links.abhinesh.codes",
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "dev": "next dev",
    "prebuild": "node scripts/gen-qr.mjs && node scripts/copy-pdfjs.mjs",
    "build": "next build",
    "preview": "node scripts/serve-out.mjs",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test:e2e": "playwright test",
    "images": "node scripts/gen-images.mjs",
    "check": "npm run lint && npm run typecheck && npm run build && npm run test:e2e"
  },
  "dependencies": {
    "@phosphor-icons/react": "2.1.10",
    "@tailwindcss/postcss": "^4.3.3",
    "next": "16.4.0",
    "pdfjs-dist": "6.4.299",
    "postcss": "^8.5.29",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "tailwindcss": "^4.3.3"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@playwright/test": "1.64.0",
    "@types/node": "24.19.2",
    "@types/qrcode": "1.5.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.0",
    "qrcode": "1.5.4",
    "typescript": "5.9.3"
  }
}
